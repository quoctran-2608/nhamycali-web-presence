# COPY THIS FILE LOCALLY TO secrets/.env
# NEVER COMMIT secrets/.env

# Private registration/login mailbox selected by the project owner.
# Actual value intentionally omitted from Git.
REGISTRATION_EMAIL=

# Do not place the mailbox password here unless the local automation
# environment explicitly requires it and the file remains local/ignored.
REGISTRATION_EMAIL_PASSWORD=

# SMS verification contacts selected by the owner.
# PRIMARY = Vietnam mobile, preferred.
# FALLBACK = U.S. business phone only when a platform does not accept the VN number.
# Store both in international E.164-style format locally.
SMS_PHONE_PRIMARY=
SMS_PHONE_FALLBACK=

# Optional recovery contact. Leave empty unless separately approved.
RECOVERY_EMAIL=

# Defaults
PREFERRED_USERNAME=nhamycali
DEFAULT_COUNTRY=US
DEFAULT_LANGUAGE=en-US

# Password-manager integration should use environment-specific references.
# Example only; do not commit real tokens.
PASSWORD_MANAGER_ITEM_PREFIX=NHAMYCALI
